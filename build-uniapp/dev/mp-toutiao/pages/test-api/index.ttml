<view class="container data-v-db407d6b"><view class="tabs data-v-db407d6b"><view class="{{('tab-item') + ' ' + 'data-v-db407d6b' + ' ' + (a && 'active')}}" bindtap="{{b}}"> 百度新闻 </view><view class="{{('tab-item') + ' ' + 'data-v-db407d6b' + ' ' + (c && 'active')}}" bindtap="{{d}}"> 淘宝搜索提示 </view></view><view class="tab-content data-v-db407d6b"><view tt:if="{{e}}" class="tab-pane data-v-db407d6b"><button class="btn-primary data-v-db407d6b" bindtap="{{f}}">GET</button></view><view tt:if="{{g}}" class="tab-pane data-v-db407d6b"><view class="search-input-wrapper data-v-db407d6b"><input placeholder="请输入内容" class="search-input data-v-db407d6b" value="{{h}}" bindinput="{{i}}"/><text tt:if="{{j}}" class="clear-btn data-v-db407d6b" bindtap="{{k}}">✕</text></view><button class="btn-primary data-v-db407d6b" bindtap="{{l}}">GET</button></view></view><view tt:if="{{m}}" class="dialog-overlay data-v-db407d6b" bindtap="{{v}}"><view class="dialog-container data-v-db407d6b" catchtap="{{t}}"><view class="dialog-header data-v-db407d6b"><text class="dialog-title data-v-db407d6b">{{n}}</text></view><view class="dialog-body data-v-db407d6b"><view class="dialog-stats data-v-db407d6b">共 <text class="stats-number data-v-db407d6b">{{o}}</text> 条数据</view><view class="table-container data-v-db407d6b"><view class="table-wrapper data-v-db407d6b"><view class="table-row table-header data-v-db407d6b"><view tt:for="{{p}}" tt:for-item="header" tt:key="b" class="table-cell data-v-db407d6b">{{header.a}}</view></view><view tt:for="{{q}}" tt:for-item="row" tt:key="b" class="{{('table-row') + ' ' + 'data-v-db407d6b' + ' ' + (row.c && 'stripe-even')}}"><view tt:for="{{row.a}}" tt:for-item="header" tt:key="d" class="table-cell data-v-db407d6b"><text tt:if="{{header.a}}" class="link-icon data-v-db407d6b" bindtap="{{header.b}}">🔗</text><text tt:else class="data-v-db407d6b">{{header.c}}</text></view></view></view></view><view class="json-container data-v-db407d6b"><text class="json-content data-v-db407d6b">{{r}}</text></view></view><view class="dialog-footer data-v-db407d6b"><button class="btn-close data-v-db407d6b" bindtap="{{s}}">关 闭</button></view></view></view></view>